{
  "name": "aqua-sentinel-integrity-hook",
  "version": "1.3.0",
  "description": "Hook de verificación continua para trazabilidad Kiro REQ-*, motor determinista, hidrología de grafo, persistencia, proveedor IA, ledger SHA-256, TypeScript y compilación.",
  "triggers": ["onSave:src/**/*.ts", "onSave:.kiro/specs/*.md", "preBuild"],
  "traceability": {
    "specsDir": ".kiro/specs",
    "requirePrefix": "REQ-",
    "validateReferencedFiles": true
  },
  "checks": [
    {
      "id": "unit-tests-all",
      "command": "npx --yes tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
      "required": true
    },
    {
      "id": "typescript-typecheck",
      "command": "npm run lint",
      "required": true
    },
    {
      "id": "production-bundle",
      "command": "npm run build",
      "required": true
    }
  ]
}


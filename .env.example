# Aqua Sentinel: variables de entorno (copia este archivo a .env y ajusta). Ver el README.

# IA (opcional). Sin clave, todo el flujo crítico sigue con el adaptador determinista.
# GEMINI_API_KEY="tu-clave"
# GEMINI_MODEL="gemini-2.5-flash"

# Ubicación del estado. En modo público el valor por defecto es data/public-demo/aqua-sentinel-state.json.
# AQUA_STATE_PATH="data/aqua-sentinel-state.json"

# MODO PÚBLICO: cualquiera explora sin iniciar sesión, solo en lectura y con datos simulados. Equivale a "npm run public".
# AQUA_PUBLIC_MODE=1
# AQUA_PUBLIC_KEEP_STATE=1
# AQUA_MEDIA_ORIGINS=https://cdn.ejemplo.org

# Producción (obligatorias si NODE_ENV=production)
# AQUA_ALLOWED_HOSTS=aqua.ejemplo.org
# AQUA_ALLOWED_ORIGINS=https://aqua.ejemplo.org
# AQUA_TRUSTED_PROXIES=10.0.0.1
# Cuenta de evaluación para jueces (usuario judge, rol OPERATOR). Mínimo 12 caracteres. Solo por entorno; nunca en el repositorio.
# AQUA_JUDGE_PASSWORD=
